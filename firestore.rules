rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // อนุญาตเฉพาะเจ้าของบัญชีคนเดียวเท่านั้น
    // แทนที่ PUT_OWNER_UID_HERE ด้วย User UID จาก Firebase Console → Authentication → Users
    match /{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == "PUT_OWNER_UID_HERE";
    }
  }
}
